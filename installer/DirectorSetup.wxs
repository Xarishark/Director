<!-- Director setup.exe: installs the Windows App Runtime when it is missing, then the Director MSI.
     Built by scripts/package-msi.ps1 after Director.wxs. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle Name="Director" Manufacturer="$(var.Publisher)" Version="$(var.Version)"
          UpgradeCode="79ED9238-A425-46F4-8144-04D20E1CBDB9"
          IconSourceFile="$(var.ReleaseDir)\director.ico" DisableModify="yes">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense" LicenseUrl=""
          ThemeFile="$(var.InstallerDir)\theme\DirectorSetup.thm.xml"
          LocalizationFile="$(var.InstallerDir)\theme\DirectorSetup.thm.wxl"
          LogoFile="$(var.LogoFile)" SuppressOptionsUI="yes" ShowVersion="yes"
          LaunchTarget="[ProgramFiles64Folder]Director\director.exe" />
      <!-- Title bar and taskbar icon; the theme's Window/@IconFile refers to this payload. -->
      <Payload SourceFile="$(var.ReleaseDir)\director.ico" Name="director.ico" />
    </BootstrapperApplication>

    <!-- Checkbox on the welcome page; quiet installs can pass DesktopShortcut=0. -->
    <Variable Name="DesktopShortcut" Type="numeric" Value="1" bal:Overridable="yes" />

    <!-- The pinned runtime registers this package key for each user it is installed for. -->
    <util:RegistrySearch Id="WindowsAppRuntimeSearch" Variable="WindowsAppRuntimeRegistered" Result="exists"
        Root="HKCU" Key="Software\Classes\Local Settings\Software\Microsoft\Windows\CurrentVersion\AppModel\Repository\Packages\$(var.RuntimePackage)" />

    <!-- Director needs Windows 11 24H2 (build 26100) or newer: its HDR switching uses display APIs added in 24H2,
         and nothing older is tested. WindowsBuildNumber is Burn's built-in variable with the real build. -->
    <bal:Condition Condition="WindowsBuildNumber &gt;= 26100"
        Message="Director needs Windows 11, version 24H2 or newer. Update Windows from Settings &gt; Windows Update, then run setup again." />


    <Chain>
      <ExePackage Id="WindowsAppRuntime" DisplayName="Windows App Runtime $(var.RuntimeVersion)"
                  DetectCondition="WindowsAppRuntimeRegistered" Permanent="yes" PerMachine="yes" Vital="yes"
                  Cache="remove" InstallArguments="--quiet">
        <!-- Pinned Microsoft-signed installer from https://learn.microsoft.com/windows/apps/windows-app-sdk/downloads.
             Regenerate with: wix burn remotepayload <file> -du <url> -packagetype exe -->
        <ExePackagePayload Name="windowsappruntimeinstall-$(var.RuntimeVersion)-x64.exe" ProductName="Windows App SDK"
            Description="WindowsAppRuntimeInstall.exe"
            DownloadUrl="https://aka.ms/windowsappsdk/2.6/$(var.RuntimeVersion)/windowsappruntimeinstall-x64.exe"
            Hash="602336F06392E981CA4E8D8223CE7ED9A353164B0EC4CC528805E78F07E0B86079F5F2A1FC4E9E94CA27EAF6CDE1BCE28D2EF65C4700DD5682964ED8C7F11A43"
            Size="124945208" Version="2.6" />
      </ExePackage>
      <MsiPackage Id="Director" DisplayName="Director" SourceFile="$(var.MsiFile)">
        <MsiProperty Name="DESKTOPSHORTCUT" Value="[DesktopShortcut]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
