<!-- Director application package. Users install it through DirectorSetup.wxs (setup.exe), which installs the
     Windows App Runtime first and shows the setup UI. This MSI has no custom dialogs of its own. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Director" Manufacturer="$(var.Publisher)" Codepage="1252" Version="$(var.Version)"
           UpgradeCode="A5865718-8A6A-4D26-B658-A35A2D636870" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Director is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPCOMMENTS" Value="$(var.Description)" />
    <!-- setup.exe passes the user's checkbox choice. Defaults to a desktop shortcut for direct msiexec installs. -->
    <Property Id="DESKTOPSHORTCUT" Value="1" />
    <Icon Id="DirectorIcon" SourceFile="$(var.ReleaseDir)\director.ico" />
    <Property Id="ARPPRODUCTICON" Value="DirectorIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Director">
        <Component Id="Application" Guid="*">
          <File Id="DirectorExe" Source="$(var.ReleaseDir)\director.exe" KeyPath="yes">
            <Shortcut Id="DirectorMenu" Directory="ProgramMenuFolder" Name="Director"
                      WorkingDirectory="INSTALLFOLDER" Icon="DirectorIcon">
              <ShortcutProperty Key="System.AppUserModel.ID" Value="Director.Desktop" />
              <ShortcutProperty Key="System.AppUserModel.ToastActivatorCLSID" Value="{D67AFF0D-9557-4CA7-B644-EF5805578032}" />
            </Shortcut>
          </File>
        </Component>
        <Component Id="DesktopShortcut" Guid="*" Condition="DESKTOPSHORTCUT = &quot;1&quot;">
          <Shortcut Id="DirectorDesktop" Directory="DesktopFolder" Name="Director" Target="[#DirectorExe]"
                    WorkingDirectory="INSTALLFOLDER" Icon="DirectorIcon" />
          <RegistryValue Root="HKLM" Key="Software\Director\Installer" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
        <Component Id="RunProtocol" Guid="*">
          <RegistryValue Root="HKLM" Key="Software\Classes\director-run" Type="string" Value="URL:Director run" KeyPath="yes" />
          <RegistryValue Root="HKLM" Key="Software\Classes\director-run" Name="URL Protocol" Type="string" Value="" />
          <RegistryValue Root="HKLM" Key="Software\Classes\director-run\shell\open\command" Type="string" Value="&quot;[#DirectorExe]&quot; &quot;%1&quot;" />
        </Component>
        <Component Id="MachinePath" Guid="*">
          <RegistryValue Root="HKLM" Key="Software\Director\Installer" Name="MachinePath" Type="integer" Value="1" KeyPath="yes" />
          <Environment Id="AppendMachinePath" Name="PATH" Action="set" Part="last" System="yes" Value="[INSTALLFOLDER]" />
        </Component>
        <Component Id="WindowIcon" Guid="*">
          <File Source="$(var.ReleaseDir)\director.ico" />
        </Component>
        <Directory Id="IconsFolder" Name="icons">
          <Component Id="DeleteIcon" Guid="*"><File Source="$(var.ReleaseDir)\icons\delete.svg" /></Component>
          <Component Id="RemoteIcon" Guid="*"><File Source="$(var.ReleaseDir)\icons\remote.svg" /></Component>
        </Directory>
        <Directory Id="OrientationFolder" Name="orientations">
          <Component Id="Orientation0" Guid="*"><File Source="$(var.ReleaseDir)\orientations\0.svg" /></Component>
          <Component Id="Orientation90" Guid="*"><File Source="$(var.ReleaseDir)\orientations\90.svg" /></Component>
          <Component Id="Orientation180" Guid="*"><File Source="$(var.ReleaseDir)\orientations\180.svg" /></Component>
          <Component Id="Orientation270" Guid="*"><File Source="$(var.ReleaseDir)\orientations\270.svg" /></Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />
    <Feature Id="DirectorFeature" Title="Director">
      <ComponentGroupRef Id="DirectorFiles" />
    </Feature>
  </Package>
  <Fragment>
    <ComponentGroup Id="DirectorFiles">
      <ComponentRef Id="Application" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="RunProtocol" />
      <ComponentRef Id="MachinePath" />
      <ComponentRef Id="WindowIcon" />
      <ComponentRef Id="DeleteIcon" />
      <ComponentRef Id="RemoteIcon" />
      <ComponentRef Id="Orientation0" />
      <ComponentRef Id="Orientation90" />
      <ComponentRef Id="Orientation180" />
      <ComponentRef Id="Orientation270" />
    </ComponentGroup>
  </Fragment>
</Wix>
